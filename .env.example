# ==============================================================================
# VARIABLES DE ENTORNO — PLATAFORMA CORPORATIVA E INTRANET POWER BI
# ==============================================================================
# Copie este archivo a .env.local para desarrollo local.
# NUNCA suba archivos .env.local ni credenciales reales al repositorio Git.

# --- Supabase (Variables Públicas: visibles en el navegador) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-supabase-anon-key

# --- Supabase (Variable Privada: SOLO SERVIDOR, nunca prefijo NEXT_PUBLIC_) ---
# Requerida para la API administrativa (crear/eliminar/bloquear usuarios).
SUPABASE_SERVICE_ROLE_KEY=tu-supabase-service-role-key

# --- URL base de la aplicación ---
# En local: http://localhost:3000
# En producción (Render): https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Identidad Corporativa (Opcional: sobrescribe placeholders de src/config/site.ts) ---
NEXT_PUBLIC_COMPANY_NAME="Findex"
NEXT_PUBLIC_COMPANY_TAGLINE="Claridad financiera, cada semana"

# --- Notificaciones por correo del formulario de contacto (Resend - SOLO SERVIDOR) ---
# Obtenga su API Key gratuita en https://resend.com/api-keys
RESEND_API_KEY=
# Correo(s) destino donde llegarán los mensajes (puede separar varios con coma)
CONTACT_NOTIFY_EMAIL=samuelhh92@gmail.com
# Remitente: usar "Findex <onboarding@resend.dev>" mientras no verifique su propio dominio
RESEND_FROM_EMAIL="Findex <onboarding@resend.dev>"
